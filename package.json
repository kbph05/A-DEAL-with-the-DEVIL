{
  "name": "a-deal-with-the-devil",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode test",
    "build": "tsc && vite build",
    "build:test": "tsc && vite build --mode test --outDir dist-test",
    "preview": "vite preview",
    "preview:test": "vite preview --outDir dist-test",
    "mock:devil": "tsx scripts/mock-devil-server.ts",
    "test": "tsx --test src/**/*.test.ts",
    "play": "tsx src/game/repl.ts",
    "fixtures": "tsx src/game/__fixtures__/generate.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
