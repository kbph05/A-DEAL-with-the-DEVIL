{
  // For Vercel's compile of the function (the nearest tsconfig to api/deal.ts). The root tsconfig is noEmit with
  // allowImportingTsExtensions, which can't be used to emit; this one can, and api/ imports nothing outside itself.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["."]
}
